{"ts":"2026-10-11T03:45:34.454Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1841,"action":"execute","params":{"action":"execute","code":"var t = typeof(UnityEngine.Rendering.PassIdentifier);\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"Type: \" + t.FullName + \"  IsValueType=\" + t.IsValueType);\nsb.AppendLine(\"--- Constructors ---\");\nforeach (var c in t.GetConstructors(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance))\n{\n    sb.AppendLine(\"  \" + (c.IsPublic ? \"public \" : \"non-public \") + c.ToString());\n}\nvar def = default(UnityEngine.Rendering.PassIdentifier);\nsb.AppendLine(\"--- default value ---\");\nsb.AppendLine(\"  SubshaderIndex=\" + def.SubshaderIndex + \"  PassIndex=\" + def.PassIndex);\n// 试验：能否用反射写入只读属性背后的字段\nsb.AppendLine(\"--- backing fields ---\");\nforeach (var f in t.GetFields(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance))\n{\n    sb.AppendLine(\"  \" + (f.IsPublic ? \"public \" : \"non-public \") + f.FieldType.Name + \" \" + f.Name);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
