{"ts":"2026-10-11T03:46:22.754Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1776,"action":"execute","params":{"action":"execute","code":"var t = System.Type.GetType(\"ShaderLearningInspector, Assembly-CSharp-Editor\");\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"类型是否找到: \" + (t != null));\nif (t != null)\n{\n    sb.AppendLine(\"完整名: \" + t.FullName);\n    var open = t.GetMethod(\"Open\", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static);\n    sb.AppendLine(\"Open 方法: \" + (open != null ? \"存在\" : \"缺失\"));\n    if (open != null)\n    {\n        try\n        {\n            open.Invoke(null, null);\n            var w = UnityEditor.EditorWindow.GetWindow(t);\n            sb.AppendLine(\"窗口打开结果: \" + (w != null ? \"成功 -> \" + w.titleContent.text : \"返回 null\"));\n            sb.AppendLine(\"编译链路: OK\");\n        }\n        catch (System.Exception e)\n        {\n            sb.AppendLine(\"打开失败: \" + e.GetType().Name + \" / \" + e.Message);\n        }\n    }\n    // 顺带确认反射用的 API 在运行时真的能取到\n    var kws = typeof(UnityEditor.ShaderUtil).GetMethods(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static);\n    int n = 0;\n    foreach (var m in kws) if (m.Name == \"GetPassKeywords\") n++;\n    sb.AppendLine(\"ShaderUtil.GetPassKeywords 重载数: \" + n);\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
